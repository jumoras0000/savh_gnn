# ════════════════════════════════════════════════════════════════════
#  Panacée — variables d'environnement (copier en .env, NE PAS committer)
#  Toutes sont OPTIONNELLES : l'app démarre sans, avec des valeurs par défaut.
# ════════════════════════════════════════════════════════════════════

# ── Assistant Claude (onglet Assistant) ──────────────────────────────
# Sans clé, un assistant local prend le relais (appelle quand même les outils).
# La clé peut aussi être saisie directement dans l'UI (stockée en base locale).
ANTHROPIC_API_KEY=

# Revue ChatGPT Phase 4 (facultative, accès API OpenAI distinct)
# OPENAI_MODEL doit être un identifiant auquel ton projet API a effectivement accès.
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Tableau de bord : emplacement des runs d'entraînement ────────────
# Défaut : <projet>/checkpoints
PANACEE_CKPT_ROOT=

# Journal téléchargé ou fichier d'un serveur monté localement (SMB/SSHFS).
# /api/runs le synchronise toutes les 15 s sans écraser un run plus récent.
PANACEE_SYNC_SOURCE=
PANACEE_SYNC_RUN_ID=

# Rapatriement JupyterHub (facultatif) : si vides, la connexion enregistrée
# dans VS Code/Jupyter File Explorer est lue localement. Le jeton n'est pas
# envoyé au navigateur et n'apparaît pas dans les URLs.
PANACEE_JUPYTER_URL=
PANACEE_JUPYTER_TOKEN=
# Si actif, /api/runs vérifie le serveur toutes les 5 min et importe
# automatiquement les journaux dès que le serveur personnel est disponible.
PANACEE_JUPYTER_AUTO_SYNC=0

# ── Base SQLite des conversations de l'assistant ─────────────────────
# Défaut : <projet>/webapp/panacee.db
PANACEE_DB=

# ── Suivi TEMPS RÉEL À DISTANCE (entraînement Kaggle → ce dashboard) ──
# À définir CÔTÉ KAGGLE pour que chaque epoch soit poussé vers ton dashboard
# (exposé via un tunnel type ngrok / cloudflared).
#   PANACEE_PUSH_URL   : URL publique de ton dashboard (ex. https://xxxx.ngrok.io)
#   PANACEE_PUSH_RUN   : identifiant du run distant (ex. kaggle_phase2)
#   PANACEE_PUSH_TOKEN : doit correspondre à PANACEE_INGEST_TOKEN ci-dessous
PANACEE_PUSH_URL=
PANACEE_PUSH_RUN=
PANACEE_PUSH_TOKEN=

# ── Sécurité de l'ingestion (côté dashboard) ─────────────────────────
# Si défini, /api/ingest exige ce token (refuse 403 sinon). Fortement
# recommandé dès que le dashboard est exposé sur Internet.
PANACEE_INGEST_TOKEN=
PANACEE_API_TOKEN=

# Laboratoire VIH : identifiants autorisés dans les sélecteurs (séparés par virgules).
# Seuls les modèles réellement accessibles avec vos clés/compte peuvent être appelés.
PANACEE_CLAUDE_MODELS=claude-opus-4-7
PANACEE_OPENAI_MODELS=
PANACEE_CLAUDE_CLI_MODELS=sonnet
PANACEE_CODEX_CLI_MODELS=
# PANACEE_OFFLINE=1 désactive tout service réseau ; Codex/Ollama reste local.
PANACEE_OFFLINE=0

# ── Encodage console (Windows surtout) ───────────────────────────────
PYTHONIOENCODING=utf-8
